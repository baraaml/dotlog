package com.example.dotlog.service

import android.app.*
import android.content.Context
import android.content.Intent
import android.os.Build
import android.os.IBinder
import androidx.core.app.NotificationCompat
import com.example.dotlog.DotlogApplication
import com.example.dotlog.MainActivity
import com.example.dotlog.R
import com.example.dotlog.data.LocationRepository
import com.google.android.gms.location.ActivityTransition
import com.google.android.gms.location.DetectedActivity
import kotlinx.coroutines.*
import kotlinx.coroutines.flow.collectLatest

class LocationService : Service() {
    private val serviceScope = CoroutineScope(SupervisorJob() + Dispatchers.IO)
    private lateinit var locationRepository: LocationRepository

    private var lastLatitude: Double? = null
    private var lastLongitude: Double? = null

    override fun onCreate() {
        super.onCreate()
        locationRepository = LocationRepository(this)
        createNotificationChannel()
    }

    override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {
        startForeground(NOTIFICATION_ID, createNotification())

        serviceScope.launch {
            ActivityTransitionReceiver.transitions.collect { (activityType, transitionType) ->
                if (transitionType == ActivityTransition.ACTIVITY_TRANSITION_ENTER) {
                    when (activityType) {
                        DetectedActivity.WALKING, DetectedActivity.IN_VEHICLE -> {
                            val location = locationRepository.requestSingleFreshLocation()
                            location?.let {
                                lastLatitude = it.latitude
                                lastLongitude = it.longitude
                            }
                        }
                    }
                }
            }
        }

        return START_STICKY
    }

    override fun onDestroy() {
        // Final visit write on service stop
        writeFinalVisit()
        serviceScope.cancel()
        super.onDestroy()
    }

    override fun onTaskRemoved(rootIntent: Intent?) {
        super.onTaskRemoved(rootIntent)
        // If app is swiped away, we might want to log the visit now
        writeFinalVisit()
        stopSelf()
    }

    private fun writeFinalVisit() {
        val lat = lastLatitude
        val lon = lastLongitude
        if (lat != null && lon != null) {
            val app = (application as DotlogApplication)
            val repository = app.repository
            val poiRepository = app.poiRepository
            // Use runBlocking with timeout to avoid hanging the system if network is slow/gone
            runBlocking {
                withTimeoutOrNull(3000L) {
                    val placeName = poiRepository.resolvePlaceName(lat, lon)
                    repository.addVisit(lat, lon, placeName, System.currentTimeMillis())
                }
            }
        }
    }

    private fun createNotificationChannel() {
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
            val channel = NotificationChannel(
                CHANNEL_ID,
                "Location Tracking",
                NotificationManager.IMPORTANCE_LOW
            )
            val manager = getSystemService(NotificationManager::class.java)
            manager.createNotificationChannel(channel)
        }
    }

    private fun createNotification(): Notification {
        val intent = Intent(this, MainActivity::class.java)
        val pendingIntent = PendingIntent.getActivity(
            this, 0, intent, PendingIntent.FLAG_IMMUTABLE
        )

        return NotificationCompat.Builder(this, CHANNEL_ID)
            .setContentTitle("Dotlog Tracking Active")
            .setContentText("Keeping track of your movement in the background.")
            .setSmallIcon(android.R.drawable.ic_menu_mylocation)
            .setContentIntent(pendingIntent)
            .setOngoing(true)
            .build()
    }

    override fun onBind(intent: Intent?): IBinder? = null

    companion object {
        private const val CHANNEL_ID = "location_tracking_channel"
        private const val NOTIFICATION_ID = 1
    }
}

