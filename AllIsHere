@Composable
fun MainScreen(viewModel: MainViewModel = viewModel()) {
    val context = LocalContext.current
    var permissionsGranted by remember {
        mutableStateOf(checkInitialPermissions(context))
    }

    val isTracking by viewModel.isTracking.collectAsState()
    val location by viewModel.currentLocation.collectAsState()
    val placeName by viewModel.currentPlaceName.collectAsState()
    val visits by viewModel.allVisits.collectAsState()
    val showHistory by viewModel.showHistoryOnMap.collectAsState()
    val zoomTarget by viewModel.zoomTarget.collectAsState()

    // Handle backgrounding per requirement
    val lifecycleOwner = androidx.lifecycle.compose.LocalLifecycleOwner.current
    DisposableEffect(lifecycleOwner) {
        val observer = androidx.lifecycle.LifecycleEventObserver { _, event ->
            if (event == androidx.lifecycle.Lifecycle.Event.ON_STOP) {
                if (viewModel.isTracking.value) {
                    // Capture visit on backgrounding
                    viewModel.logCurrentVisit()
                    // Start foreground service for background survival
                    val intent = Intent(context, LocationService::class.java)
                    if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
                        context.startForegroundService(intent)
                    } else {
                        context.startService(intent)
                    }
                }
            } else if (event == androidx.lifecycle.Lifecycle.Event.ON_START) {
                // Refresh permission state when returning to foreground
                permissionsGranted = checkInitialPermissions(context)
                // Stop foreground service when returning to foreground
                context.stopService(Intent(context, LocationService::class.java))
            }
        }
        lifecycleOwner.lifecycle.addObserver(observer)
        onDispose {
            lifecycleOwner.lifecycle.removeObserver(observer)
        }
    }

    if (!permissionsGranted) {
        PermissionRequestScreen {
            permissionsGranted = checkInitialPermissions(context)
        }
    } else {
        @OptIn(ExperimentalMaterial3Api::class)
        val scaffoldState = rememberBottomSheetScaffoldState()

        @OptIn(ExperimentalMaterial3Api::class)
        BottomSheetScaffold(
            scaffoldState = scaffoldState,
            sheetPeekHeight = 120.dp,
            sheetShape = MaterialTheme.shapes.extraLarge,
            sheetContainerColor = MaterialTheme.colorScheme.surface,
            sheetContent = {
                VisitsList(
                    modifier = Modifier.fillMaxWidth().heightIn(min = 400.dp),
                    visits = visits,
                    showHistoryOnMap = showHistory,
                    onToggleHistory = { viewModel.toggleHistoryOnMap() },
                    onVisitClick = { viewModel.zoomToVisit(it.latitude, it.longitude) }
                )
            }
        ) { innerPadding ->
            Box(modifier = Modifier.padding(innerPadding).fillMaxSize()) {
                // Full Screen Map
                MapViewCompose(
                    modifier = Modifier.fillMaxSize(),
                    currentLocation = location,
                    visits = visits,
                    showHistory = showHistory,
                    zoomTarget = zoomTarget,
                    onZoomConsumed = { viewModel.clearZoomTarget() }
                )

                // Floating Live POI Card (Top Zone)
                Card(
                    modifier = Modifier
                        .statusBarsPadding()
                        .padding(16.dp)
                        .fillMaxWidth()
                        .align(Alignment.TopCenter),
                    shape = MaterialTheme.shapes.large,
                    colors = CardDefaults.cardColors(
                        containerColor = MaterialTheme.colorScheme.surface.copy(alpha = 0.95f)
                    ),
                    elevation = CardDefaults.cardElevation(defaultElevation = 8.dp)
                ) {
                    Row(
                        modifier = Modifier.padding(16.dp),
                        verticalAlignment = Alignment.CenterVertically
                    ) {
                        Box(
                            modifier = Modifier
                                .size(12.dp)
                                .background(
                                    if (isTracking) SuccessGreen else Color.Gray,
                                    shape = androidx.compose.foundation.shape.CircleShape
                                )
                        )
                        Spacer(Modifier.width(12.dp))
                        Column {
                            Text(
                                text = if (isTracking) "Live Tracking" else "Tracking Paused",
                                style = MaterialTheme.typography.labelSmall,
                                color = MaterialTheme.colorScheme.onSurfaceVariant
                            )
                            Text(
                                text = placeName,
                                style = MaterialTheme.typography.titleMedium,
                                fontWeight = FontWeight.Bold
                            )
                        }
                    }
                }

                // Tracking Toggle (Bottom Zone - Thumb Friendly)
                FloatingActionButton(
                    onClick = { if (isTracking) viewModel.stopTracking() else viewModel.startTracking() },
                    modifier = Modifier
                        .align(Alignment.BottomEnd)
                        .padding(end = 16.dp, bottom = 32.dp),
                    containerColor = if (isTracking) MaterialTheme.colorScheme.errorContainer else MaterialTheme.colorScheme.primary,
                    shape = androidx.compose.foundation.shape.CircleShape
                ) {
                    Text(
                        text = if (isTracking) "Stop" else "Start",
                        modifier = Modifier.padding(horizontal = 16.dp)
                    )
                }
            }
        }
    }
}

@Composable
fun PermissionRequestScreen(onPermissionsChanged: () -> Unit) {
    val context = LocalContext.current

    val launcher = rememberLauncherForActivityResult(
        contract = ActivityResultContracts.RequestMultiplePermissions()
    ) { _ ->
        onPermissionsChanged()
    }

    val singleLauncher = rememberLauncherForActivityResult(
        contract = ActivityResultContracts.RequestPermission()
    ) { _ ->
        onPermissionsChanged()
    }

    Column(
        modifier = Modifier.fillMaxSize().padding(24.dp),
        verticalArrangement = Arrangement.Center,
        horizontalAlignment = Alignment.CenterHorizontally
    ) {
        Text(
            text = "Permissions Required",
            style = MaterialTheme.typography.headlineMedium
        )
        Spacer(modifier = Modifier.height(16.dp))
        Text(
            text = "Dotlog needs location and activity recognition permissions to track your visits and movement efficiently.",
            style = MaterialTheme.typography.bodyLarge
        )
        Spacer(modifier = Modifier.height(32.dp))

        Button(onClick = {
            val permissions = mutableListOf(
                Manifest.permission.ACCESS_FINE_LOCATION,
                Manifest.permission.ACCESS_COARSE_LOCATION
            )
            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {
                permissions.add(Manifest.permission.ACTIVITY_RECOGNITION)
            }
            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
                permissions.add(Manifest.permission.POST_NOTIFICATIONS)
            }
            launcher.launch(permissions.toTypedArray())
        }) {
            Text("Grant Basic Permissions")
        }

        if (hasBasicPermissions(context) && !hasBackgroundLocation(context)) {
            Spacer(modifier = Modifier.height(16.dp))
            Text(
                text = "For background tracking, please also allow 'Allow all the time' in location settings.",
                style = MaterialTheme.typography.bodySmall
            )
            Button(onClick = {
                if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {
                    singleLauncher.launch(Manifest.permission.ACCESS_BACKGROUND_LOCATION)
                }
            }) {
                Text("Grant Background Location")
            }
        }

        Spacer(modifier = Modifier.height(16.dp))
        TextButton(onClick = {
            val intent = Intent(Settings.ACTION_APPLICATION_DETAILS_SETTINGS).apply {
                data = Uri.fromParts("package", context.packageName, null)
            }
            context.startActivity(intent)
        }) {
            Text("Open App Settings")
        }
    }
}

private fun checkInitialPermissions(context: android.content.Context): Boolean {
    return hasBasicPermissions(context) && hasBackgroundLocation(context)
}

private fun hasBasicPermissions(context: android.content.Context): Boolean {
    val fine = ContextCompat.checkSelfPermission(context, Manifest.permission.ACCESS_FINE_LOCATION) == PackageManager.PERMISSION_GRANTED
    val activity = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {
        ContextCompat.checkSelfPermission(context, Manifest.permission.ACTIVITY_RECOGNITION) == PackageManager.PERMISSION_GRANTED
    } else true
    return fine && activity
}

private fun hasBackgroundLocation(context: android.content.Context): Boolean {
    return if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {
        ContextCompat.checkSelfPermission(context, Manifest.permission.ACCESS_BACKGROUND_LOCATION) == PackageManager.PERMISSION_GRANTED
    } else true
}

